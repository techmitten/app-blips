# Headers for the static files Cloudflare serves for the Worker (wrangler.jsonc
# copies this into dist/). The same security headers as server.js and the
# desktop app (electron/server/staticFiles.js), and the same caching: Vite's
# hashed bundles never change, everything else is revalidated.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.mp4
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.webm
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.webp
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.ico
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/provider-logos/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/showcase/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache
