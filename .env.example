# Settings for running AppBlips in a browser: `npm start`, `npm run dev`, or
# Docker. The desktop app doesn't read this file: set your AI provider there
# under Settings → AI.
#
# Everything here is optional. Copy this file to .env and fill in what you need.
# The easiest setup is to leave it empty and pick a provider, key and model in
# the app under Settings → AI. That works with every provider, including
# Anthropic; the key is kept by the server on this computer, not in the browser.

# ---- AI provider for the server ---------------------------------------------
# Used when Settings → AI has no provider; with it set, onboarding and
# Settings → AI offer visitors a Free option that needs no key. The key alone
# is enough for OpenAI (sk-proj-…), Anthropic (sk-ant-…), Gemini (AIza…),
# xAI (xai-…) and OpenRouter (sk-or-…) keys; other keys go to DeepSeek unless OPENAI_LLM_PROVIDER or OPENAI_BASE_URL says
# otherwise. Works with any service that speaks the OpenAI chat-completions API.
OPENAI_API_KEY=
# Blank picks the provider's newest general model (needed with a custom
# OPENAI_BASE_URL).
OPENAI_LLM_MODEL=
# Optional: deepseek, openai, anthropic, gemini, xai or openrouter. Blank means
# guess from the key, else DeepSeek. Use it for an older plain sk- OpenAI key.
OPENAI_LLM_PROVIDER=
# Blank means the provider's own endpoint. Example: https://openrouter.ai/api/v1
OPENAI_BASE_URL=
# Optional: a model for requests with an attached image, on the same service.
OPENAI_LLM_VISION_MODEL=
# Optional: sampling temperature (default 0.2).
OPENAI_LLM_TEMPERATURE=

# ---- Limits on the Free option (the provider above) ---------------------------
# For a server other people can reach. Requests with a visitor's own key are
# never limited. A visitor is an IP address; 0 turns one limit off. Set
# APPBLIPS_FREE_LIMITS=off on a server only you use.
APPBLIPS_FREE_LIMITS=
# Per visitor (defaults: 120 an hour, 4 at once, 2,000,000 tokens a UTC day).
APPBLIPS_FREE_REQUESTS_PER_HOUR=
APPBLIPS_FREE_CONCURRENT=
APPBLIPS_FREE_TOKENS_PER_IP_PER_DAY=
# Everyone together, per UTC day (default 30,000,000 tokens).
APPBLIPS_FREE_TOKENS_PER_DAY=
# Output limit per request (default 32,000 tokens).
APPBLIPS_FREE_MAX_OUTPUT_TOKENS=

# ---- Server ------------------------------------------------------------------
# Port for `npm start` (default 3000). With Docker, set APPBLIPS_PORT instead.
PORT=
# Port Docker publishes on your computer (default 3000).
APPBLIPS_PORT=
# AppBlips only answers at localhost. To open it under another name (a reverse
# proxy's domain, say), list the names here, comma-separated. It has no
# sign-in: anyone who can reach it can spend the key above.
APPBLIPS_ALLOWED_HOSTS=
# Behind a reverse proxy that changes the Host header, list the exact address
# you open AppBlips at, e.g. https://appblips.example.com
APPBLIPS_CHAT_ALLOWED_ORIGINS=
# Folder for the API key you enter under Settings → AI in the browser version
# (it is kept here, readable only by you, not in the browser). Defaults to
# .appblips in your home folder; the Docker image uses /data.
APPBLIPS_DATA_DIR=
