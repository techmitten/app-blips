# Settings for running AppBlips in a browser: `npm start`, `npm run dev`, or
# Docker. The desktop app doesn't read this file: set your AI provider there
# under Settings → AI.
#
# Everything here is optional. Copy this file to .env and fill in what you need.
# The easiest setup is to leave it empty and pick a provider, key and model in
# the app under Settings → AI. That works with every provider, including
# Anthropic. Each visitor's key is kept in their own browser, not on the server.

# ---- AI provider for the server ---------------------------------------------
# Used when Settings → AI has no provider; with it set, onboarding and
# Settings → AI offer visitors a Free option that needs no key. The key alone
# is enough for OpenAI (sk-proj-…), Anthropic (sk-ant-…), Gemini (AIza…),
# xAI (xai-…) and OpenRouter (sk-or-…) keys; other keys go to DeepSeek unless OPENAI_LLM_PROVIDER or OPENAI_BASE_URL says
# otherwise. Works with any service that speaks the OpenAI chat-completions API.
OPENAI_API_KEY=
# Blank picks the provider's newest general model (needed with a custom
# OPENAI_BASE_URL).
OPENAI_LLM_MODEL=
# Optional: deepseek, openai, anthropic, gemini, xai or openrouter. Blank means
# guess from the key, else DeepSeek. Use it for an older plain sk- OpenAI key.
OPENAI_LLM_PROVIDER=
# Blank means the provider's own endpoint. Example: https://openrouter.ai/api/v1
OPENAI_BASE_URL=
# Optional: a model for requests with an attached image, on the same service.
OPENAI_LLM_VISION_MODEL=
# Optional: sampling temperature (default 0.0).
OPENAI_LLM_TEMPERATURE=

# Optional: the exact output token limit for every Free AI request (the
# provider above). When set, the limit in Settings → AI is ignored and hidden
# while Free is in use. Requests with a user's own key always keep the user's
# limit. Blank leaves it to each user (default 64,000 for building).
APPBLIPS_MAX_OUTPUT_TOKENS=

# Optional: the reasoning level for every Free AI request: off, minimal, low,
# medium, high, xhigh or max. A level the model lacks becomes the nearest one
# it has. Anthropic: off, low, medium, high, xhigh, max (minimal runs as low;
# Opus 5.5 can't turn reasoning off, so off runs as low; Opus/Sonnet 4.6 have
# no xhigh; models before 4.6, such as Haiku 4.5, ignore it). Higher levels
# are slower and cost more; low or medium suits a public Free option.
# When set, the Reasoning choice in Settings → AI is hidden while Free is in
# use. Requests with a user's own key always keep the user's level. Quick
# replies (clarifying questions, Ask mode) still run with reasoning off.
# Blank leaves it to each user (default medium).
APPBLIPS_REASONING_EFFORT=

# ---- Limits on the Free option (the provider above) ---------------------------
# For a server other people can reach. Requests with a visitor's own key are
# never limited. A visitor is an IP address, or the signed-in account when
# sign-in is on (below). Set APPBLIPS_FREE_LIMITS=off on a server only you use.
APPBLIPS_FREE_LIMITS=
# Rate limits always apply and can't be changed: per visitor, 6 messages a
# minute, 3 s between messages, 120 AI requests an hour and 4 at once.
#
# Usage caps are off unless set (blank or 0 means no cap):
# tokens per visitor per UTC day,
APPBLIPS_FREE_TOKENS_PER_IP_PER_DAY=
# tokens for everyone together per UTC day,
APPBLIPS_FREE_TOKENS_PER_DAY=
# and the most output tokens per request (blank keeps the app's own 64,000, or
# what the user sets in Settings → AI). Unlike APPBLIPS_MAX_OUTPUT_TOKENS, this
# only lowers a larger limit; it never raises a smaller one.
APPBLIPS_FREE_MAX_OUTPUT_TOKENS=
# Optional (Cloudflare Worker): Access control for the visual Free AI Usage
# Dashboard at /admin/usage (backed by GET /api/admin/free-usage).
# Comma-separated Clerk user IDs allowed to sign in with Google/GitHub:
APPBLIPS_ADMIN_USER_IDS=
# Optional standalone Bearer secret (set with `npx wrangler secret put APPBLIPS_ADMIN_TOKEN`):
APPBLIPS_ADMIN_TOKEN=

# ---- Sign-in for the Free option -------------------------------------------------
# Optional, for a public server: with both set, using the Free option requires
# signing in through your Clerk application (allow only Google and GitHub in
# its dashboard), and the limits above count each account instead of each IP
# address. Visitors with their own key never sign in. CLERK_JWT_KEY is the PEM
# public key from the Clerk dashboard (API keys → JWT public key); tokens are
# checked with it, without contacting Clerk. A one-line value with \n works.
# APPBLIPS_FREE_SIGN_IN=off turns sign-in off while keeping the keys.
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_KEY=
# Optional: Clerk secret key (sk_live_… / sk_test_…). Also lets /admin/usage
# display each signed-in user's email address alongside their Clerk user_… ID.
CLERK_SECRET_KEY=
APPBLIPS_FREE_SIGN_IN=
# Optional: sync new/updated Clerk users into a Resend email list via
# POST /api/webhooks/clerk (Clerk Dashboard → Webhooks). If RESEND_AUDIENCE_ID
# is blank, the first audience in your Resend account is used.
CLERK_WEBHOOK_SIGNING_SECRET=
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# ---- Photo library -------------------------------------------------------------
# Optional: an Unsplash app's Access Key (unsplash.com/developers). With it, the
# AI picks real, credited photos from Unsplash for websites and apps instead of
# writing image addresses from memory. Everyone using this server shares the
# key's hourly limit (50 requests for a demo app, 1,000 once Unsplash approves
# it). The Secret Key isn't needed.
UNSPLASH_ACCESS_KEY=

# ---- Server ------------------------------------------------------------------
# Port for `npm start` (default 3000). With Docker, set APPBLIPS_PORT instead.
PORT=
# Port Docker publishes on your computer (default 3000).
APPBLIPS_PORT=
# AppBlips only answers at localhost. To open it under another name (a reverse
# proxy's domain, say), list the names here, comma-separated. It has no
# sign-in: anyone who can reach it can spend the key above.
APPBLIPS_ALLOWED_HOSTS=
# Behind a reverse proxy that changes the Host header, list the exact address
# you open AppBlips at, e.g. https://appblips.example.com
APPBLIPS_CHAT_ALLOWED_ORIGINS=
# Folder where the server cleans up key files that older versions saved here
# at startup. Keys are no longer stored on the server. Defaults to .appblips in
# your home folder; the Docker image uses /data.
APPBLIPS_DATA_DIR=
