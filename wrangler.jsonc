// The browser version on Cloudflare Workers (worker/index.js). `npx wrangler
// deploy` builds the client and uploads it with the Worker; Cloudflare serves
// dist/ itself, and only /api/* runs the Worker. Settings (the Free option's
// provider and key, the APPBLIPS_FREE_* limits, UNSPLASH_ACCESS_KEY, …) go in
// the dashboard's Variables and Secrets, or `npx wrangler secret put NAME`;
// for `npx wrangler dev`, in a .dev.vars file. The desktop app, `npm start`
// and Docker don't use any of this.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app-blips",
  "main": "worker/index.js",
  "compatibility_date": "2025-11-01",
  // Buffer, node:stream and friends, used by the shared handlers.
  "compatibility_flags": ["nodejs_compat"],
  // Settings live in the dashboard. Without this, each deploy from GitHub
  // replaces the dashboard's plain-text variables with this file's (none),
  // wiping OPENAI_LLM_MODEL and the like; secrets are never touched.
  "keep_vars": true,
  "build": {
    "command": "npx vite build --mode desktop --sourcemap && cp worker/_headers dist/_headers"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Client-side routes get index.html, like server.js's fallback.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // The Free option's counts (worker/freeLimitsObject.js). The free plan only
  // offers SQLite-backed Durable Objects.
  "durable_objects": {
    "bindings": [{ "name": "FREE_LIMITS", "class_name": "FreeLimits" }]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "appblips",
      "database_id": "c910bde3-a443-453a-b4cf-6dca0c7408a4"
    }
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FreeLimits"] }],
  "observability": { "enabled": true },
  "vars": {
    "APPBLIPS_ADMIN_USER_IDS": "user_3MIK0Pr8R9Tl9O8ToITvCtlkrad",
    "APPBLIPS_FREE_AI": "off",
    "APPBLIPS_FREE_SIGN_IN": "off",
    "APPBLIPS_FREE_TOKENS_PER_DAY": "50000000",
    "APPBLIPS_FREE_TOKENS_PER_IP_PER_DAY": "10000000",
    "APPBLIPS_MAX_OUTPUT_TOKENS": "64000",
    "APPBLIPS_REASONING_EFFORT": "low",
    "CLERK_JWT_KEY": "-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAuU7TURl9IOdujcxu4mqD\nTMXq1LRFCiXI/WvThIKF28HopHpBwNGqRJtpZ6UyazvFRo8ef/+CUBbcNiwHGvNl\nNdnYDWvmnQbNrYeqNviMUZ1ZtfeNWSrcTlGcubVEsD1+7Fp3UubUtMFOzLZjiP/v\nhYwV55yZZk5/ahL/ndMwtWucsTgBgBujeZvsRvGPLVMq/qi0WCQeik+0Yeq+qcgw\neKjku3VvP+6N+Ksrdjsqsv8rAXfXg3WiWaREaeHs/FJ8ZX7Kc0CwW81KmUPs6CMh\nL8KnXhIjyZtptWs8Gt67q1izY6CTrlpLuWM7TQMjH4uVqd8KG+fDCAaK0nGDG9/k\ngQIDAQAB\n-----END PUBLIC KEY-----\n",
    "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuYXBwYmxpcHMuY29tJA",
    "OPENAI_LLM_MODEL": "claude-haiku-5-5",
    "OPENAI_LLM_PROVIDER": "anthropic"
  }
}
