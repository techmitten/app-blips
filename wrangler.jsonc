// The browser version on Cloudflare Workers (worker/index.js). `npx wrangler
// deploy` builds the client and uploads it with the Worker; Cloudflare serves
// dist/ itself, and only /api/* runs the Worker. Settings (UNSPLASH_ACCESS_KEY,
// …) go in the dashboard's Variables and Secrets, or `npx wrangler secret put NAME`;
// for `npx wrangler dev`, in a .dev.vars file. The desktop app, `npm start`
// and Docker don't use any of this.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app-blips",
  "main": "worker/index.js",
  "compatibility_date": "2025-11-01",
  // Buffer, node:stream and friends, used by the shared handlers.
  "compatibility_flags": ["nodejs_compat"],
  // Settings live in the dashboard. Without this, each deploy from GitHub
  // replaces the dashboard's plain-text variables with this file's (none);
  // secrets are never touched.
  "keep_vars": true,
  "build": {
    "command": "npx vite build --mode desktop --sourcemap && cp worker/_headers dist/_headers"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Client-side routes get index.html, like server.js's fallback.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Per-visitor Unsplash search counts (worker/unsplashLimitsObject.js). The
  // free plan only offers SQLite-backed Durable Objects.
  "durable_objects": {
    "bindings": [{ "name": "UNSPLASH_LIMITS", "class_name": "UnsplashLimits" }]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "appblips",
      "database_id": "c910bde3-a443-453a-b4cf-6dca0c7408a4"
    }
  ],
  // v3 deletes the old Free AI counter and its stored counts.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FreeLimits"] },
    { "tag": "v2", "new_sqlite_classes": ["UnsplashLimits"] },
    { "tag": "v3", "deleted_classes": ["FreeLimits"] }
  ],
  "observability": { "enabled": true }
}
